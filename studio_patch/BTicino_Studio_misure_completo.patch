+++ b/Alpha/frontend/src/MeasurementPanel.tsx
@@ -0,0 +1,109 @@
+import { useEffect, useMemo, useState } from 'react';
+import { Alert, Button, InputNumber, Input, Modal, Radio, Select, Space } from 'antd';
+import { api } from './api';
+import type { MeasurementAssembly, Project } from './types';
+
+type Option = { id: string; etichetta: string; disegnabile: boolean; motivo?: string | null };
+type Options = { modi: Option[]; strumenti: { articolo: string; descrizione: string }[] };
+
+const FALLBACK: Options = {
+    modi: [
+        { id: 'upstream_general', etichetta: 'A monte del generale', disegnabile: false, motivo: 'Disegno sull’arrivo linea ancora da integrare.' },
+        { id: 'downstream_general', etichetta: 'A valle del generale', disegnabile: true },
+        { id: 'downstream_device', etichetta: 'A valle di un’utenza', disegnabile: true },
+    ],
+    strumenti: [
+        { articolo: 'MFD41ORFCDT', descrizione: 'Multifunzione con TA Rogowski' },
+        { articolo: 'MFD4421', descrizione: 'Multifunzione con TA' },
+    ],
+};
+
+type Props = {
+    project: Project;
+    /** null = nuova misura */
+    measurementId: string | null;
+    /** dispositivo preselezionato (es. dopo un trascinamento) */
+    deviceId?: string | null;
+    onClose: () => void;
+    onApply: (project: Project) => void;
+};
+
+export function MeasurementPanel({ project, measurementId, deviceId, onClose, onApply }: Props) {
+    const existing: MeasurementAssembly | undefined = (project.measurementAssemblies || []).find((m: MeasurementAssembly) => m.id === measurementId);
+    const roots = useMemo(() => project.nodes.filter(n => !n.parent), [project.nodes]);
+    const [options, setOptions] = useState<Options>(FALLBACK);
+    const initialDevice = deviceId || existing?.measuredFeeder || null;
+    const initialMode = existing?.placement?.mode
+        || (initialDevice ? (roots.length === 1 && roots[0].id === initialDevice ? 'downstream_general' : 'downstream_device') : 'downstream_general');
+    const [mode, setMode] = useState<string>(initialMode);
+    const [device, setDevice] = useState<string | null>(initialDevice || (roots.length === 1 ? roots[0].id : null));
+    const [instrument, setInstrument] = useState<string | null>(existing?.articleProposal || null);
+    const [ratio, setRatio] = useState<string>(existing?.ratio || '');
+    const [quantity, setQuantity] = useState<number | null>(existing?.quantity ?? null);
+    const [error, setError] = useState('');
+    const [busy, setBusy] = useState(false);
+
+    useEffect(() => {
+        let alive = true;
+        api<any>('/api/measurement/options', { project }).then(o => { if (alive && o.modi) setOptions({ modi: o.modi, strumenti: o.strumenti }); }).catch(() => undefined);
+        return () => { alive = false; };
+    }, []);
+
+    const candidates = mode === 'downstream_general' ? roots : project.nodes;
+    const describe = (n: Project['nodes'][number]) => `${n.sigla} · ${n.values?.articolo || (n.articles || [])[0] || n.kind} · ${n.label}`;
+
+    function pickMode(next: string) {
+        setMode(next);
+        if (next === 'downstream_general') setDevice(roots.length === 1 ? roots[0].id : null);
+    }
+
+    async function apply() {
+        setError('');
+        if (!device) { setError(mode === 'downstream_general' ? 'Scegli l’interruttore generale.' : 'Scegli l’interruttore dell’utenza misurata.'); return; }
+        if (!existing && !instrument) { setError('Scegli lo strumento da inserire.'); return; }
+        setBusy(true);
+        try {
+            const placement: Record<string, unknown> = { modo: mode, dispositivo: device };
+            if (existing) placement.misura = existing.id;
+            if (instrument) placement.strumento = instrument;
+            if (ratio.trim()) placement.rapporto = ratio.trim();
+            if (quantity !== null) placement.quantita = quantity;
+            const result = await api<{ project: Project }>('/api/measurement/place', { project, placements: [placement] });
+            onApply(result.project);
+        } catch (e) {
+            setError(e instanceof Error ? e.message : String(e));
+        } finally {
