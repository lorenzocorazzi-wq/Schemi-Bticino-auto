+"""Un modulo largo (misura) con derivazioni: la corsia di ritorno sta dopo il modulo."""
+import packing
+
+
+def _nodi():
+    return [
+        {'id': 'a', 'parent': None, 'drawingWidth': 6, 'values': {}},
+        {'id': 'b', 'parent': 'a', 'values': {}},
