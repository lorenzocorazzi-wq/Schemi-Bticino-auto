+# Coppie di caratteri che l'OCR scambia spesso (lette in entrambe le direzioni).
+_CONFUSIONI = ('01', '0O', '0D', '1I', '1L', '1T', '1A', '25', '2Z', '35', '3S', '4A', '5S', '6G', '8B', '8S')
+
+
+@lru_cache(maxsize=1)
+def _scambi() -> dict:
+    scambi: dict[str, set[str]] = {}
+    for a, b in _CONFUSIONI:
+        scambi.setdefault(a, set()).add(b)
+        scambi.setdefault(b, set()).add(a)
+    return scambi
+
+
+def correggi_ocr(codice: str) -> str | None:
+    """Unico codice di listino raggiungibile scambiando UN carattere confuso dall'OCR.
+
+    Restituisce None se il codice e' gia' valido, se non c'e' nessuna correzione
+    o se ce ne sono piu' di una (ambiguo: lo decide l'operatore).
+    """
+    codice = normalizza(codice)
+    if not codice or esiste(codice):
+        return None
+    scambi = _scambi()
+    candidati = set()
+    for i, carattere in enumerate(codice):
+        for altro in scambi.get(carattere, ()):
+            variante = codice[:i] + altro + codice[i + 1:]
+            if esiste(variante):
+                candidati.add(variante)
+    return candidati.pop() if len(candidati) == 1 else None
