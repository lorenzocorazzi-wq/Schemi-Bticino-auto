 def codici(sorgente) -> collections.Counter:
     return collections.Counter(c for articolo in estrai_articoli(sorgente) for c in articolo['codici'])
+
+
+_TOKEN_TESTO = re.compile(r'[A-Z0-9][A-Z0-9/\-]*[A-Z0-9]')
+
+
+def _e_articolo_testo(token: str) -> bool:
+    if not listino.esiste(token):
+        return False
+    return bool(re.fullmatch(r'\d{6}', token) or (re.search(r'[A-Z]', token) and re.search(r'\d', token)))
+
+
+def codici_da_testo_pagine(sorgente) -> collections.Counter:
+    """Codici in listino scritti come testo normale della pagina (PDF senza annotazioni FreeText)."""
+    pagine, da_chiudere = _pagine(sorgente)
+    conteggio: collections.Counter = collections.Counter()
+    try:
+        for pagina in pagine:
+            testo = pagina.get_text().upper()
+            conteggio.update(t for t in _TOKEN_TESTO.findall(testo) if _e_articolo_testo(t))
+    finally:
+        if da_chiudere is not None:
+            da_chiudere.close()
+    return conteggio
